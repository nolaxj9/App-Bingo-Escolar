// Cloudflare Workers con archivos estáticos: publica dist/ tal cual, sin código de servidor.
// Uso: npm run build && npx wrangler deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bingo-escolar",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
